# Frontend (local dev)
VITE_API_URL=http://localhost:3000
# Customer-facing View Prospectus / Copy Link origin (baked into the SPA at build time).
# Defaults to https://prospectus.delphi-me.com when unset. App can still load on *.cloudfront.net.
VITE_PUBLIC_WEB_URL=https://prospectus.delphi-me.com

# Backend / Lambda
QUOTES_TABLE=delphinium-quotes
CONFIG_TABLE=delphinium-config
PDF_BUCKET=delphinium-quote-pdfs
WEB_BASE_URL=http://localhost:5173
PROSPECTUS_BASE_URL=http://localhost:5173
# Zoho CRM. Leave the secrets empty until a token is provided; the API will not call Zoho.
# Scopes: ZohoCRM.modules.accounts.READ, ZohoCRM.modules.accounts.UPDATE
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
SLACK_BOT_TOKEN=
SLACK_QUOTES_CHANNEL=
API_PASSWORD=delphinium
ADMIN_PASSWORD=delphiniumadmin
# Machine read-only token for Sales assistants (GET /quotes, /quotes/search, /quotes/{id}).
# Live source of truth: SSM /delphinium/prospectus/sales-read-token (do not commit real values).
SALES_READ_TOKEN=

# Hermes (on VPS)
PROSPECTUS_API_URL=
PROSPECTUS_WEB_URL=
PROSPECTUS_SALES_READ_TOKEN=
